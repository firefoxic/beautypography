{
	"name": "@firefoxic/beautypography",
	"version": "0.2.1",
	"description": "Binds function words, numbers and em dashes in Markdown prose with non-breaking spaces",
	"license": "MIT",
	"author": {
		"name": "Sergey Artemov",
		"email": "firefoxic.dev@gmail.com"
	},
	"homepage": "https://github.com/firefoxic/beautypography#readme",
	"bugs": {
		"url": "https://github.com/firefoxic/beautypography/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/firefoxic/beautypography.git"
	},
	"type": "module",
	"bin": {
		"beautypography": "dist/bin/cli.js"
	},
	"exports": {
		".": {
			"types": "./dist/lib/index.d.ts",
			"import": "./dist/lib/index.js"
		},
		"./package.json": "./package.json"
	},
	"sideEffects": false,
	"files": [
		"./dist/"
	],
	"scripts": {
		"help": "make help",
		"prepare": "git config --local core.hooksPath .githooks || true"
	},
	"engines": {
		"node": ">=22.22.2"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "22.22.2",
			"onFail": "download"
		},
		"packageManager": {
			"name": "pnpm",
			"version": ">=12.18",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@firefoxic/oxlint-config": "~0.5",
		"@types/node": "^26",
		"@vitest/coverage-v8": "^5",
		"@vitest/ui": "^5",
		"oxlint": "^1",
		"tsdown": "~0.23",
		"tsrs": "~0.22.0-ts7",
		"vitest": "^5"
	},
	"keywords": [
		"typography",
		"markdown",
		"prose",
		"non-breaking-space",
		"nbsp",
		"function-words",
		"em-dash",
		"linter",
		"formatter",
		"cli"
	]
}
