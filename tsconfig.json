{
	"compilerOptions": {
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": [
			"vitest/globals"
		],
		"exactOptionalPropertyTypes": true,
		"noUncheckedIndexedAccess": true,
		"skipLibCheck": true,
		"declaration": true,
		"noEmit": true,
		"noEmitOnError": true,
		"resolveJsonModule": true,
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,
	},
	"include": [
		"**/*",
	],
	"exclude": [
		"dist",
		"node_modules",
	]
}
